# A demonstração não envia pedidos e não usa contas reais.
STORE_MODE=demo
# Em live, os três valores Supabase são obrigatórios. Não use NEXT_PUBLIC_ na chave secreta.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Origem da loja, lida no servidor quando a instalação é executada.
SITE_URL=http://localhost:3000
# Endpoint opcional /api/cron/expire. Gere um token aleatório com no mínimo 32 caracteres.
CRON_SECRET=
# Segredo estável de acompanhamento. Gere outro token aleatório com pelo menos 32 caracteres.
ORDER_TOKEN_SECRET=
