{
  "name": "commerce-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "test:http": "node scripts/smoke.mjs --http-only",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "client:init": "node --import tsx scripts/create-client.mjs",
    "format": "prettier --write src config tests scripts docs '*.json' '*.md' '*.ts' '*.mjs' '.github/**/*.yml'",
    "db:setup-sql": "node --import tsx scripts/setup-sql.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
